# =========================================================================
# International Student Compliance Management System (ISCMS)
# Environment Configuration Template
# =========================================================================

# 1. Public Database Variables (Safe for Browser/Client Hydration)
# -------------------------------------------------------------------------
# The REST API endpoint URL of your Supabase project instance.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key safe for client-side API requests. Subject to Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Institutional Branding Name displayed across UI and notifications
NEXT_PUBLIC_INSTITUTION_NAME=National Forensic Sciences University

# 1B. Application Canonical URL & Deployment Strategy
# -------------------------------------------------------------------------
# Canonical URL of your deployed ISCMS instance.
# If unset on Vercel, automatically resolves via VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
# NEXT_PUBLIC_APP_URL=https://iscms.youruniversity.edu
# NEXT_PUBLIC_SITE_URL=https://iscms.youruniversity.edu

# 2. Private Administrative Database Variables (SERVER SIDE ONLY)
# -------------------------------------------------------------------------
# Administrative service-role key capable of bypassing Row Level Security.
# WARNING: NEVER expose this key in client-side code, git check-ins, or logs.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# 3. Object Storage Configuration (SERVER SIDE ONLY)
# -------------------------------------------------------------------------
# Storage provider engine (default: supabase)
STORAGE_PROVIDER=supabase

# 4. Notification Engine Gateways (SERVER SIDE ONLY)
# -------------------------------------------------------------------------
# Set EMAIL_PROVIDER to "resend" or "mock" (default: mock)
EMAIL_PROVIDER=mock
# RESEND_API_KEY=re_your_api_key_placeholder
# RESEND_FROM_EMAIL=compliance@youruniversity.edu

# Set WHATSAPP_PROVIDER to "meta" or "mock" (default: mock)
WHATSAPP_PROVIDER=mock
# META_ACCESS_TOKEN=your-meta-access-token
# META_PHONE_NUMBER_ID=your-phone-number-id
# WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
# WHATSAPP_TEMPLATE_NAME=efrro_expiry_alert

# 5. Bot Protection (Cloudflare Turnstile) — Optional
# -------------------------------------------------------------------------
# If configured, Turnstile bot protection is enforced on login forms.
# If unset, login forms skip the security check (acceptable for internal deployments).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAA...your-site-key
# TURNSTILE_SECRET_KEY=0x4AAA...your-secret-key
